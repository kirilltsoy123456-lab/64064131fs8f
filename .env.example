# Create a bot with @BotFather and paste its token here.
BOT_TOKEN=replace-with-telegram-bot-token

# Google Sheets spreadsheet ID from its URL.
GOOGLE_SHEETS_ID=replace-with-spreadsheet-id
GOOGLE_CREDENTIALS_FILE=service-account.json

# IANA timezone for Kazakhstan time.
TIMEZONE=Asia/Almaty
# Local daily reminder times, comma-separated, 24-hour HH:MM format.
REMINDER_TIMES=09:00,18:00
ATTENDANCE_WORKSHEET=Attendance
USERS_WORKSHEET=Users
